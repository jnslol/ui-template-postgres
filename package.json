{
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently --kill-others --names api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch --env-file-if-exists=.env --import tsx server/index.ts",
    "dev:web": "vite",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "start": "node --env-file-if-exists=.env --import tsx server/index.ts --static",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env --import tsx server/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env --import tsx server/seed.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "lucide-react": "1.79.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@hono/node-server": "2.1.11",
    "@hono/zod-validator": "0.9.1",
    "@tanstack/react-query": "5.108.4",
    "@tanstack/react-router": "1.170.46",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.22",
    "tsx": "4.23.15",
    "zod": "4.6.7",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "26.6.7",
    "@types/react": "19.3.1",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "concurrently": "9.2.5",
    "drizzle-kit": "0.31.11",
    "@types/pg": "8.23.1"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  },
  "name": "ui-template-postgres"
}
